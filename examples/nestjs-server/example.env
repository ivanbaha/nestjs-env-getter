# placeholder values — never commit a real .env (copy this file to .env and adjust locally)
PORT=3000
NODE_ENV=development

# Basic variables
TEST_CONFIG_NUMBER=123 # comment after ENV
TEST_CONFIG_STRING=Hello
TEST_CONFIG_BOOLEAN=true
APP_STAGE=alpha
APP_STAGE_DEFAULTED=alpha
REQUEST_TIMEOUT_MS=12_500
MAINTENANCE_MODE=false
API_URL=https://api.example.com/v1
CDN_URL=https://cdn.example.com/assets
SESSION_TTL=2h
WORKER_INTERVAL=45s
# Demonstrates getOptionalTimePeriod(name, numberDefaultMs, resultIn)
CACHE_TTL=120s
# Demonstrates the no-default getOptionalTimePeriod overloads; remove this line to see them return undefined
GRACE_PERIOD=90s

# List getters (GET-5)
CORS_ORIGINS="https://app.example.com, https://admin.example.com"
ENABLED_REGIONS="us-east, eu-west"
OPTIONAL_FEATURE_FLAGS="dark-mode; beta-ui"

# Quoting examples
SINGLE_QUOTED_VAL='This is a "literal" value with # no comments'
DOUBLE_QUOTED_VAL="Line one\nLine two\tTabbed\nEscaped \"quote\""
# Single quotes suppress ${...} interpolation (v1.2.0); this stays literal, not expanded
LITERAL_TEMPLATE='${APP_NAME} is not interpolated here'

# Multiline example (RSA-like)
PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
MIIEpAIBAAKCAQEA75B6...
...more data...
-----END RSA PRIVATE KEY-----
"

# Interpolation examples
APP_NAME=ExampleApp
APP_TITLE="Welcome to ${APP_NAME}"
BASE_URL=http://localhost:${PORT}

# Export prefix example
export DATABASE_URL="postgres://user:pass@localhost:5432/db"

# Empty value
EMPTY_VAL=

# Array examples (required + optional with (el, index, array) validator)
ALLOWED_DOMAINS='["google.com", "github.com", "microsoft.com"]'
OPTIONAL_WEBHOOK_URLS='["https://hooks.example.com/events", "https://hooks.example.com/alerts"]'

# Multiline Object example
COMPLEX_CONFIG="{
  \"featureEnabled\": true,
  \"maxUsers\": 100,
  \"apiEndpoint\": \"https://api.example.com\",
  \"retryConfig\": {
    \"count\": 3,
    \"interval\": 500
  }
}"

# Multiline Object example (single-quoted, no escapes needed)
SIMPLE_CONFIG='{
  "name": "MyApp",
  "version": 123,
  "enabled": true
}'

INLINE_OBJECT_CONFIG='{"retries": 4, "strategy": "exponential"}'
OPTIONAL_OBJECT_JSON='{"retries": 2, "strategy": "fixed"}'
OPTIONAL_TYPED_OBJECT_JSON='{"name": "OptionalSvc", "version": 2, "enabled": true}'

# Cron schedule examples (consumed by TasksConfig via AppConfigModule.forFeature)
# 5-field format: minute hour day-of-month month day-of-week
BACKUP_SCHEDULE="0 2 * * *"  # Runs at 2:00 AM daily
# Optional: 6-field format with seconds: second minute hour day-of-month month day-of-week
CLEANUP_SCHEDULE="0 */15 * * * *"  # Runs every 15 minutes
