{
    "name": "nestjs-server",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
        "build": "tsc -p tsconfig.build.json",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "tsc -p tsconfig.build.json && node dist/main",
        "start:dev": "tsc -p tsconfig.build.json --watch",
        "start:debug": "node --inspect-brk dist/main",
        "start:prod": "node dist/main",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json"
    },
    "dependencies": {
        "@nestjs/common": "11.2.7",
        "@nestjs/core": "11.2.7",
        "@nestjs/platform-express": "11.2.7",
        "@nestjs/schedule": "6.1.3",
        "cron": "4.4.0",
        "nestjs-env-getter": "file:../../",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2"
    },
    "devDependencies": {
        "@nestjs/testing": "11.2.7",
        "@types/cron": "2.4.3",
        "@types/express": "5.0.6",
        "@types/jest": "30.0.0",
        "@types/node": "26.2.0",
        "@types/supertest": "7.2.1",
        "jest": "30.4.2",
        "prettier": "3.9.6",
        "source-map-support": "0.5.21",
        "supertest": "7.2.2",
        "ts-compiler": "npm:typescript@6.0.3",
        "ts-jest": "29.4.12",
        "ts-node": "10.9.2",
        "tsconfig-paths": "4.2.0",
        "typescript": "7.0.2"
    },
    "resolutions": {
        "path-to-regexp": "8.4.2",
        "@babel/core": "7.29.7",
        "js-yaml": "4.3.2",
        "form-data": "4.0.6",
        "qs": "6.16.1",
        "picomatch": "4.0.5",
        "brace-expansion": "5.0.12",
        "fast-uri": "3.1.7",
        "body-parser": "2.3.0",
        "browserslist": "4.29.3",
        "baseline-browser-mapping": "2.11.29",
        "handlebars": "4.7.10",
        "proxy-addr": "2.0.8"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": [
                "<rootDir>/../test/ts-jest-transformer.cjs",
                {
                    "compiler": "ts-compiler"
                }
            ]
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}
