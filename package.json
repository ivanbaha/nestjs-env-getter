{
    "name": "nestjs-env-getter",
    "version": "1.3.0",
    "description": "Environment variables getter for Nestjs applications",
    "author": "Ivan Baha",
    "private": false,
    "main": "dist/index.js",
    "bin": {
        "nestjs-env-getter": "./bin/nestjs-env-getter.mjs"
    },
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "bin",
        "src/app-config/app.config.ts.example",
        "CHANGELOG.md"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ivanbaha/nestjs-env-getter"
    },
    "license": "MIT",
    "scripts": {
        "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
        "build": "tsc --p tsconfig.build.json",
        "format": "prettier --write \"src/**/*.ts\"",
        "test": "jest",
        "test:report": "jest --ci --coverage --runInBand",
        "typecheck": "tsc --noEmit --p tsconfig.build.json"
    },
    "engines": {
        "node": ">=20"
    },
    "resolutions": {
        "@babel/core": "7.29.7",
        "js-yaml": "4.3.2",
        "brace-expansion": "5.0.12",
        "browserslist": "4.29.3",
        "baseline-browser-mapping": "2.11.29",
        "handlebars": "4.7.10"
    },
    "peerDependencies": {
        "@nestjs/common": ">=9"
    },
    "dependencies": {},
    "devDependencies": {
        "@nestjs/common": "11.2.7",
        "@nestjs/core": "11.2.7",
        "@nestjs/testing": "11.2.7",
        "@types/jest": "30.0.0",
        "@types/node": "26.6.5",
        "jest": "30.4.2",
        "prettier": "3.9.6",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "ts-compiler": "npm:typescript@6.0.3",
        "ts-jest": "29.4.12",
        "typescript": "7.0.2"
    }
}
