{
    "name": "nestjs-env-getter",
    "version": "1.2.0",
    "description": "Environment variables getter for Nestjs applications",
    "author": "Ivan Baha",
    "private": false,
    "main": "dist/index.js",
    "bin": {
        "nestjs-env-getter": "./bin/nestjs-env-getter.mjs"
    },
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "bin",
        "src/app-config/app.config.ts.example",
        "CHANGELOG.md"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ivanbaha/nestjs-env-getter"
    },
    "license": "MIT",
    "scripts": {
        "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
        "build": "tsc --p tsconfig.build.json",
        "format": "prettier --write \"src/**/*.ts\"",
        "lint": "eslint --fix",
        "lint:report": "eslint --ignore-pattern \"examples/**\"",
        "test": "jest",
        "test:report": "jest --ci --coverage --runInBand",
        "typecheck": "tsc --noEmit --p tsconfig.build.json"
    },
    "engines": {
        "node": ">=20"
    },
    "resolutions": {
        "**/@angular-devkit/core/ajv": "^8.18.0",
        "**/@angular-devkit/core/picomatch": "^4.0.5",
        "@babel/core": "7.29.7",
        "js-yaml": "4.3.1",
        "brace-expansion": "5.0.9",
        "fast-uri": "3.1.7"
    },
    "peerDependencies": {
        "@nestjs/common": ">=9"
    },
    "dependencies": {},
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@nestjs/cli": "11.0.24",
        "@nestjs/common": "11.2.1",
        "@nestjs/core": "11.2.1",
        "@nestjs/testing": "11.2.1",
        "@types/jest": "30.0.0",
        "@types/node": "26.2.0",
        "eslint": "10.8.1",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-jsdoc": "64.2.0",
        "eslint-plugin-prettier": "5.5.6",
        "globals": "17.11.0",
        "jest": "30.4.2",
        "prettier": "3.9.6",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "ts-jest": "29.4.12",
        "typescript": "6.0.3",
        "typescript-eslint": "8.67.0"
    }
}
