{
    "name": "nestjs-env-getter",
    "version": "1.1.3",
    "description": "Environment variables getter for Nestjs applications",
    "author": "Ivan Baha",
    "private": false,
    "main": "dist/index.js",
    "bin": {
        "nestjs-env-getter": "./bin/nestjs-env-getter.mjs"
    },
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "bin",
        "src/app-config/app.config.ts.example",
        "CHANGELOG.md"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ivanbaha/nestjs-env-getter"
    },
    "license": "MIT",
    "scripts": {
        "prebuild": "rm -rf dist",
        "build": "tsc --p tsconfig.build.json",
        "format": "prettier --write \"src/**/*.ts\"",
        "lint": "eslint --fix",
        "lint:report": "eslint --ignore-pattern \"examples/**\"",
        "test": "jest",
        "test:report": "jest --ci --coverage --runInBand",
        "typecheck": "tsc --noEmit --p tsconfig.build.json"
    },
    "peerDependencies": {
        "@nestjs/common": ">=9"
    },
    "dependencies": {},
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@nestjs/cli": "11.0.21",
        "@nestjs/common": "11.1.19",
        "@nestjs/core": "11.1.19",
        "@nestjs/testing": "11.1.19",
        "@types/jest": "30.0.0",
        "@types/node": "25.6.0",
        "eslint": "10.2.1",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-jsdoc": "62.9.0",
        "eslint-plugin-prettier": "5.5.5",
        "globals": "17.5.0",
        "jest": "30.3.0",
        "prettier": "3.8.3",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "ts-jest": "29.4.9",
        "typescript": "6.0.3",
        "typescript-eslint": "8.59.1"
    }
}
